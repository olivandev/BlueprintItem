  <PropertyGroup>
    <DistDir>$(MSBuildProjectDirectory)\dist\</DistDir>
    <PackageStagingDir>$(IntermediateOutputPath)Package\</PackageStagingDir>
    <PackagePluginDir>$(PackageStagingDir)BepInEx\plugins\$(MSBuildProjectName)\</PackagePluginDir>
  </PropertyGroup>

  <Target Name="CreateReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ReleaseSpriteFiles Include="Assets\**\*.*" />
    </ItemGroup>

    <RemoveDir Directories="$(PackageStagingDir)" Condition="Exists('$(PackageStagingDir)')" />
    <MakeDir Directories="$(PackagePluginDir)" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackagePluginDir)" />
    <Copy SourceFiles="Localization.json" DestinationFolder="$(PackagePluginDir)" />
    <!--    <Copy SourceFiles="README.md" DestinationFolder="$(PackageStagingDir)" />-->
    <Copy SourceFiles="@(ReleaseSpriteFiles)"
          DestinationFiles="@(ReleaseSpriteFiles->'$(PackagePluginDir)$(MSBuildProjectName)Content\%(RecursiveDir)%(Filename)%(Extension)')" />

    <MakeDir Directories="$(DistDir)" Condition="!Exists('$(DistDir)')" />
    <ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(DistDir)$(MSBuildProjectName).zip" Overwrite="true" />
  </Target>
</Project>
